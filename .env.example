# ─────────────────────────────────────────────────────────────
# NEXUS Command Center — environment variables
# Local dev: copy to .env.local. Production: Netlify → Site configuration → Environment variables.
#
# RULE: anything prefixed VITE_ is bundled into browser JavaScript. Never put secrets in VITE_ vars.
# ─────────────────────────────────────────────────────────────

# Supabase (free tier). Project Settings → API. The anon key is public by design; RLS protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Market data source. Valid values:
#   tradingview   (default, $0) official TradingView widgets for all market visuals; no NEXUS-side prices
#   alphavantage  adds END-OF-DAY quotes/bars inside NEXUS through the Netlify Function (needs MARKET_DATA_API_KEY)
# Planned (not implemented yet — selecting them shows "not configured", never fake data): alpaca, twelvedata
# "mock" is no longer supported.
VITE_MARKET_DATA_PROVIDER=tradingview

# ── Server-side secrets (Netlify Functions only — NO VITE_ prefix) ──
# Alpha Vantage key, read by netlify/functions/market.ts
MARKET_DATA_API_KEY=
# Future Alpaca support (not used yet)
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
