# ─────────────────────────────────────────────────────────────
# NEXUS Command Center — environment variables
# Copy to .env.local for local dev. In Netlify: Site configuration → Environment variables.
# ─────────────────────────────────────────────────────────────

# Supabase (free tier). Project Settings → API.
# The anon key is DESIGNED to be public; Row Level Security protects your data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Market data provider: "mock" (DEMO data, zero config) or "alphavantage" (free tier, EOD data)
VITE_MARKET_DATA_PROVIDER=mock

# OPTIONAL and NOT RECOMMENDED for production: anything prefixed VITE_ is bundled into
# the browser JavaScript and is visible to anyone who opens DevTools.
# Only use this for local development. Leave it EMPTY on Netlify.
VITE_MARKET_DATA_API_KEY=

# RECOMMENDED for production: server-side key read only by the Netlify Function
# (netlify/functions/market.ts). It is never shipped to the browser.
MARKET_DATA_API_KEY=
